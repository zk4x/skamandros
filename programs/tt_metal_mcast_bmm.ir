# tt-metal's large-block 2D-multicast matmul at the benchmark shape, as skamandros IR.
#
# The compute kernel is `bmm_large_block_zm_fused_bias_activation_metal2.cpp`
# (ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/): its `bh`/`bw`
# out-block walk, its subblock nest and its peeled first/last k block.  The
# reader/writer pair is tt-metal's 2D-multicast one (`reader_bmm_tile_layout_in0_sender_*`
# reading A and multicasting it along each row, `reader_bmm_tile_layout_in1_sender_*`
# reading B and multicasting it down each column, `writer_bmm_tile_layout.cpp`).
# The configuration is the benchmark's own
# (`tests/ttnn/unit_tests/benchmarks/test_benchmark.py:440-530`): per-core 64x64
# tiles, `out_block_h = out_block_w = 8`, subblock `(2, 4)`,
# `fp32_dest_acc_en = False` with `packer_l1_acc = True`.
#
# `in0_block_w` is the one quantity that gives.  `get_multi_dim_per_core_factor`
# on the 2D path's all-DRAM branch
# (`ttnn/cpp/ttnn/operations/matmul/device/config/matmul_program_config.cpp:137-185`)
# shrinks it first and keeps the output block, against the CB estimate in
# `utilities/matmul_utilities.cpp:25-70`, whose input depth is
# `MCAST_INPUT_BUFFERING_DEPTH = 2` and whose partials are the packer-L1-acc
# tile size (`Float16_b` for this card's compute config).  At the benchmark's
# `in0_block_w = 16` that estimate is 1280 KiB of rings, more than the whole
# arena above the kernel config block; at 8 it is 768 KiB.  The rings below are
# that estimate tile for tile: A and B `out_block * in0_block_w` two deep,
# `interm0` and `out` `out_block_tiles` once.
#
# A's block is read from DRAM by the cores in column 0 (`cores [0, ..]`) and
# fanned out along each row; B's by the cores in row 0 (`cores [.., 0]`) and
# fanned down each column.  B arrives `[K, N]` (`in1_tensor_stride_w = 1`,
# `in1_tensor_stride_h = N`, factory :608-612).
#
# The text carries the shape's tiling as named constants and every size that
# follows from it, so a test can hand the same program a smaller tiling the
# simulator can run; the shape itself (K, N, the grid) is launch scalars.
#
# The nesting is tt-metal's: `bh`, `bw`, the k block, then the operand's row and
# k tile (readers) or the subblock's row and column (compute).  The writer's
# last two loops are `unroll`ed, as the tiling constants they are, so its ring
# hand-off stays one per subblock.
#
# Rings and why they are laid out this way:
#
# - `%ba` is A's `obh x kb` block, row-major (`h*kb + inner`), which is
#   tt-metal's `in0_index`; a subblock's `sbh x kb` block is then dense.
# - `%bb` is B's block written **subblock-major**
#   (`jsub*kb*sbw + inner*sbw + w`), so a subblock's `kb x sbw` block is dense
#   too.  tt-metal's own `inner*obw + w` order is what its per-tile index
#   needs; our `load` names a block, and a block is its tiles row-major.
# - `%interm` (tt-metal's `intermed0`) and `%bc` (`out_dfb`) are handed off one
#   subblock at a time, `block out_subblock_num_tiles` pages, and a store or
#   reload names page 0 of that hand-off -- `pack_tile(i, dfb)`/`copy_tile(i, i)`
#   with `i` inside `reserve_back(out_subblock_num_tiles)`.
#
# Two ends are peeled inside each out block because this IR has no runtime `if`,
# and tt-metal's kernel branches on the k index twice: `enable_reload = false`
# for, and `last_out` for block `num_blocks - 1`.  The peeled first block
# computes into `interm` without a reload; the peeled last block reloads, packs
# to the output ring, and the writer stores that block before the next one
# starts.  The loop between them covers `1 .. num_blocks-2`, and the reader
# mirrors that structure so a ring's hand-off is one block per body.
#
# Every tile of the band is walked by the codes as tt-metal walks it: the
# subblock nest (`in0_subblock`/`in1_subblock`) is the `%sis`/`%sjs` loop pair,
# the accumulator is one `acc bf16 64,128` block (tt-metal's `out_subblock_h x
# out_subblock_w` `Dst` region in 16-bit mode), and the operand loads name
# blocks, not tiles.
%nx = param i32 0
%ny = param i32 0
%kt = param i32 0
%ncols = param i32 0
%pa = param bf16 16384
%pw = param bf16 245760
%pc = param bf16 245760
%ba = buffer bf16 32,4096
%bb = buffer bf16 32,4096
%interm = buffer bf16 32,2048
%bc = buffer bf16 32,2048
%acc = acc bf16 64,128
%zero = const bf16 0
%izero = const i32 0
%tile = const i32 1
%kb = const i32 8
%obh = const i32 8
%obw = const i32 8
%sbh = const i32 2
%sbw = const i32 4
%nisub = const i32 4
%njsub = const i32 2
%nobh = const i32 8
%nobw = const i32 8
%pm = const i32 64
%pn = const i32 64
%apages = const i32 64
%bpages = const i32 64
%kblocks = div %kt %kb
%kmid = sub %kblocks %tile
%kloop = sub %kmid %tile
%klast = mul %kmid %kb
%x = grid.x
%y = grid.y
%m0 = mul %y %pm
%n0 = mul %x %pn
%oh = loop %nobh
%om = mul %oh %obh
%omr = add %m0 %om
%ow = loop %nobw
%on = mul %ow %obw
%onc = add %n0 %on
%ahf = loop %obh
%ahrf = add %omr %ahf
%aif = mul %ahrf %kt
%apf = mul %ahf %kb
%awf = loop %kb
%akf = add %aif %awf
%apwf = add %apf %awf
copy 32,32 %ba [%apwf] cores [0, ..] = %pa [%akf]
endloop
endloop
%bcf = loop %obw
%bjsf = div %bcf %sbw
%bkjf = mul %bjsf %kb
%bjf = mul %bkjf %sbw
%bwmf = mod %bcf %sbw
%b0f = add %bjf %bwmf
%bnf = add %onc %bcf
%bkf = loop %kb
%biif = mul %bkf %sbw
%bpf = add %b0f %biif
%bnif = mul %bkf %ncols
%bixf = add %bnif %bnf
copy 32,32 %bb [%bpf] cores [.., 0] = %pw [%bixf]
endloop
endloop
expand %ba [%apages] [.., ..] from [0, ..]
expand %bb [%bpages] [.., ..] from [.., 0]
%sis = loop %nisub
%sir = mul %sis %sbh
%sas = mul %sir %kb
%sjs = loop %njsub
%sjc = mul %sjs %sbw
%sbs = mul %sjc %kb
store 64,128 %acc = %zero
load 64,256 %sa = %ba [%sas]
load 256,128 %sb = %bb [%sbs]
matmul %acc %sa %sb
store 64,128 %interm [%izero] = %acc
endloop
endloop
%kk = loop %kloop
%kn = add %kk %tile
%k0 = mul %kn %kb
%ahm = loop %obh
%ahrm = add %omr %ahm
%aim = mul %ahrm %kt
%aimk = add %aim %k0
%apm = mul %ahm %kb
%awm = loop %kb
%akm = add %aimk %awm
%apwm = add %apm %awm
copy 32,32 %ba [%apwm] cores [0, ..] = %pa [%akm]
endloop
endloop
%bcm = loop %obw
%bjsm = div %bcm %sbw
%bkmj = mul %bjsm %kb
%bjm = mul %bkmj %sbw
%bwmm = mod %bcm %sbw
%b0m = add %bjm %bwmm
%bnm = add %onc %bcm
%bkm = loop %kb
%biim = mul %bkm %sbw
%bpm = add %b0m %biim
%bnim = mul %bkm %ncols
%bnimk = add %bnim %k0
%bixm = add %bnimk %bnm
copy 32,32 %bb [%bpm] cores [.., 0] = %pw [%bixm]
endloop
endloop
expand %ba [%apages] [.., ..] from [0, ..]
expand %bb [%bpages] [.., ..] from [.., 0]
%sim = loop %nisub
%sirm = mul %sim %sbh
%sasm = mul %sirm %kb
%sjm = loop %njsub
%sjcm = mul %sjm %sbw
%sbsm = mul %sjcm %kb
load 64,128 %acc = %interm [%izero]
load 64,256 %am = %ba [%sasm]
load 256,128 %bm = %bb [%sbsm]
matmul %acc %am %bm
store 64,128 %interm [%izero] = %acc
endloop
endloop
endloop
%ahl = loop %obh
%ahrl = add %omr %ahl
%ail = mul %ahrl %kt
%ailk = add %ail %klast
%apl = mul %ahl %kb
%awl = loop %kb
%akl = add %ailk %awl
%apwl = add %apl %awl
copy 32,32 %ba [%apwl] cores [0, ..] = %pa [%akl]
endloop
endloop
%bcx = loop %obw
%bjsl = div %bcx %sbw
%bklj = mul %bjsl %kb
%bjl = mul %bklj %sbw
%bcwl = mod %bcx %sbw
%b0l = add %bjl %bcwl
%bnl = add %onc %bcx
%bil = loop %kb
%biil = mul %bil %sbw
%bpl = add %b0l %biil
%bnil = mul %bil %ncols
%bnilk = add %bnil %klast
%bixl = add %bnilk %bnl
copy 32,32 %bb [%bpl] cores [.., 0] = %pw [%bixl]
endloop
endloop
expand %ba [%apages] [.., ..] from [0, ..]
expand %bb [%bpages] [.., ..] from [.., 0]
%sil = loop %nisub
%silr = mul %sil %sbh
%sil_a = mul %silr %kb
%sjl = loop %njsub
%sjlc = mul %sjl %sbw
%sjlb = mul %sjlc %kb
load 64,128 %acc = %interm [%izero]
load 64,256 %al = %ba [%sil_a]
load 256,128 %bl = %bb [%sjlb]
matmul %acc %al %bl
store 64,128 %bc [%izero] = %acc
endloop
endloop
# tt-metal's writer walks the subblock's `out_subblock_h x out_subblock_w`
# tiles and stores each to its own `%bc` page; the product is the loop nest,
# not a statement per tile.
%wsi = loop %nisub
%wsr0 = mul %wsi %sbh
%wsr = add %omr %wsr0
%wsj = loop %njsub
%wsc0 = mul %wsj %sbw
%wsc = add %onc %wsc0
%wr = loop %sbh unroll
%wrp = mul %wr %sbw
%wrr = add %wsr %wr
%wrpi = mul %wrr %ncols
%wc = loop %sbw unroll
%bci = add %wrp %wc
%wcc = add %wsc %wc
%widx = add %wrpi %wcc
copy 32,32 %pc [%widx] = %bc [%bci]
endloop
endloop
endloop
endloop
endloop
endloop
grid %nx,%ny
