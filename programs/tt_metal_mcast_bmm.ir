# tt-metal's large-block matmul, transcribed into skamandros IR.
#
# The compute kernel is `bmm_large_block_zm.cpp` (ttnn/cpp/ttnn/operations/
# matmul/device/kernels/compute/); the reader is the 2D-multicast pair
# `reader_bmm_tile_layout_in0.cpp` (sender) / `reader_bmm_tile_layout_in0_receiver_metal2.cpp`
# from the reuse-mcast factory, and the writer `writer_bmm_tile_layout.cpp`.
# One core owns a 4x4 band of output tiles (`obh`/`obw`), walked in 2x2
# subblocks (`out_subblock_h`/`out_subblock_w`), with `in0_block_w = 2` tiles
# of K per k block.
#
# A's block is read from DRAM by the cores in column 0 (`cores [0, ..]`) and
# fanned out along each row; B's by the cores in row 0 (`cores [.., 0]`) and
# fanned down each column.  That is tt-metal's `noc_async_read_multicast` pair, and it is
# what keeps one core's DRAM read from being repeated by every core in its row
# or column.
#
# The shape this text holds is the program's: the grid scales the band over the
# chip (`grid.x`/`grid.y` place the core's `m0`/`n0`), `%kt`/`%ncols` are launch
# scalars, and K is whatever `%kt` says.  The three `param` sizes are the
# buffers the launch hands over; the test substitutes the real sizes, exactly
# as tt-metal's tensors arrive as launch arguments.
#
# Rings and why they are laid out this way:
#
# - `%ba` is A's `obh x in0_block_w` block, row-major (`h*kb + inner`), which is
#   tt-metal's `in0_index`; a subblock's `sbh x kb` block is then dense.
# - `%bb` is B's block written **subblock-major**
#   (`jsub*kb*sbw + inner*sbw + w`), so a subblock's `kb x sbw` block is dense
#   too.  tt-metal's own `inner*obw + w` order is what its per-tile index
#   needs; our `load` names a block, and a block is its tiles row-major.
# - `%interm` (tt-metal's `intermed0`) and `%bc` (`out_dfb`) are handed off one
#   subblock at a time, `block out_subblock_num_tiles` pages, and a store or
#   reload names page 0 of that hand-off -- `pack_tile(i, dfb)`/`copy_tile(i, i)`
#   with `i` inside `reserve_back(out_subblock_num_tiles)`.
#
# Two ends are peeled because this IR has no runtime `if`, and tt-metal's kernel
# branches on the block index twice: `enable_reload = false` for, and
# `last_out` for block `num_blocks - 1`.  The peeled first block computes into
# `interm` without a reload; the peeled last block reloads and packs to the
# output ring.  The loop between them covers `1 .. num_blocks-2`, and the reader
# mirrors that structure so a ring's hand-off is one block per body.
#
# Every tile of the band is walked by the codes as tt-metal walks it: the
# subblock nest (`in0_subblock`/`in1_subblock`) is the `%si`/`%sj` loop pair,
# the accumulator is one `acc f32 64,64` block (tt-metal's `out_subblock_h x
# out_subblock_w` `Dst` region), and the operand loads name blocks, not tiles.
%nx = param i32 0
%ny = param i32 0
%kt = param i32 0
%ncols = param i32 0
%pa = param bf16 16384
%pw = param bf16 245760
%pc = param f32 245760
%ba = buffer bf16 32,512
%bb = buffer bf16 32,512
%interm = buffer f32 32,1024
%bc = buffer f32 32,256
%acc = acc f32 64,64 
%zero = const f32 0
%izero = const i32 0
%tile = const i32 1
%kb = const i32 2
%nisub = const i32 2
%njsub = const i32 2
%obh = const i32 4
%obw = const i32 4
%sbw = const i32 2
%c0 = const i32 0
%apages = const i32 8
%bpages = const i32 8
%c1 = const i32 1
%c2 = const i32 2
%c3 = const i32 3
%c4 = const i32 4
%c5 = const i32 5
%c6 = const i32 6
%c7 = const i32 7
%c8 = const i32 8
%kblocks = div %kt %kb
%kmid = sub %kblocks %tile
%kloop = sub %kmid %tile
%klast = mul %kmid %kb
%x = grid.x
%y = grid.y
%m0 = mul %y %c4
%n0 = mul %x %c4
%arow = mul %m0 %kt
%brow = mul %n0 %kt
%ah = loop %obh unroll
%ahr = mul %ah %kt
%arh = add %arow %ahr
%ak = add %arh %izero
%aw = loop %kb unroll
%ai = add %ak %aw
%ap = mul %ah %kb
%apw = add %ap %aw
copy 32,32 %ba [%apw] cores [0, ..] = %pa [%ai]
endloop
endloop
%bh = loop %obw unroll
%bhr = mul %bh %kt
%brh = add %brow %bhr
%bk = add %brh %izero
%bjs = div %bh %sbw
%bj = mul %bjs %c4
%bwm = mod %bh %sbw
%b0 = add %bj %bwm
%bi = loop %kb unroll
%bii = mul %bi %sbw
%bp = add %b0 %bii
%bix = add %bk %bi
copy 32,32 %bb [%bp] cores [.., 0] = %pw [%bix]
endloop
endloop
expand %ba [%apages] [.., ..] from [0, ..]
expand %bb [%bpages] [.., ..] from [.., 0]
%si = loop %nisub
%as = mul %si %c4
%sj = loop %njsub
%bs = mul %sj %c4
store 64,64 %acc = %zero
load 64,64 %a = %ba [%as]
load 64,64 %b = %bb [%bs]
matmul %acc %a %b
store 64,64 %interm [%izero] = %acc
endloop
endloop
%k = loop %kloop
%kn = add %k %tile
%k8 = mul %kn %kb
%ahm = loop %obh unroll
%ahrm = mul %ahm %kt
%arhm = add %arow %ahrm
%akm = add %arhm %k8
%awm = loop %kb unroll
%aim = add %akm %awm
%apm = mul %ahm %kb
%apwm = add %apm %awm
copy 32,32 %ba [%apwm] cores [0, ..] = %pa [%aim]
endloop
endloop
%bhm = loop %obw unroll
%bhrm = mul %bhm %kt
%brhm = add %brow %bhrm
%bkm = add %brhm %k8
%bjsm = div %bhm %sbw
%bjm = mul %bjsm %c4
%bwmm = mod %bhm %sbw
%b0m = add %bjm %bwmm
%bim = loop %kb unroll
%biim = mul %bim %sbw
%bpm = add %b0m %biim
%bixm = add %bkm %bim
copy 32,32 %bb [%bpm] cores [.., 0] = %pw [%bixm]
endloop
endloop
expand %ba [%apages] [.., ..] from [0, ..]
expand %bb [%bpages] [.., ..] from [.., 0]
%sim = loop %nisub
%asm = mul %sim %c4
%sjm = loop %njsub
%bsm = mul %sjm %c4
load 64,64 %acc = %interm [%izero]
load 64,64 %am = %ba [%asm]
load 64,64 %bm = %bb [%bsm]
matmul %acc %am %bm
store 64,64 %interm [%izero] = %acc
endloop
endloop
endloop
%ahl = loop %obh unroll
%ahrl = mul %ahl %kt
%arhl = add %arow %ahrl
%akl = add %arhl %klast
%awl = loop %kb unroll
%ail = add %akl %awl
%apl = mul %ahl %kb
%apwl = add %apl %awl
copy 32,32 %ba [%apwl] cores [0, ..] = %pa [%ail]
endloop
endloop
%bhl = loop %obw unroll
%bhrl = mul %bhl %kt
%brhl = add %brow %bhrl
%bkl = add %brhl %klast
%bjsl = div %bhl %sbw
%bjl = mul %bjsl %c4
%bwml = mod %bhl %sbw
%b0l = add %bjl %bwml
%bil = loop %kb unroll
%biil = mul %bil %sbw
%bpl = add %b0l %biil
%bixl = add %bkl %bil
copy 32,32 %bb [%bpl] cores [.., 0] = %pw [%bixl]
endloop
endloop
expand %ba [%apages] [.., ..] from [0, ..]
expand %bb [%bpages] [.., ..] from [.., 0]
%sil = loop %nisub
%asl = mul %sil %c4
%sjl = loop %njsub
%bsl = mul %sjl %c4
load 64,64 %acc = %interm [%izero]
load 64,64 %al = %ba [%asl]
load 64,64 %bl = %bb [%bsl]
matmul %acc %al %bl
store 64,64 %bc [%izero] = %acc
endloop
endloop
# tt-metal's writer walks the subblock's `out_subblock_h x out_subblock_w`
# tiles (2x2 here) and stores each to its own `%bc` page; the 2x2 is the loop
# nest, not four statements.
%wsi = loop %nisub
%ws = mul %wsi %c2
%wsj = loop %njsub
%wn = mul %wsj %c2
%wrow = add %m0 %ws
%wcol = add %n0 %wn
%wr = loop %c2 unroll
%wrp = mul %wr %c2
%wrowr = add %wrow %wr
%wrpi = mul %wrowr %ncols
%wc = loop %c2 unroll
%bci = add %wrp %wc
%wcolc = add %wcol %wc
%widx = add %wrpi %wcolc
copy 32,32 %pc [%widx] = %bc [%bci]
endloop
endloop
endloop
endloop
grid %nx,%ny
